{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnumbat.local/schemas/model.schema.json",
  "title": "Model (named lineage)",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^gnumbat\\.model/0\\.[0-9]+$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^md_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "creator": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "modified_at": {
      "type": "string",
      "format": "date-time"
    },
    "latest_version_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "model_id",
    "name",
    "created_at",
    "modified_at"
  ],
  "additionalProperties": true
}
