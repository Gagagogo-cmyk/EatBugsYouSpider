{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnumbat.local/schemas/analysis.schema.json",
  "title": "Bake analysis (versioned; one per extractor+config)",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^gnumbat\\.analysis/0\\.[0-9]+$"
    },
    "analysis_version": {
      "type": "string"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^an_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "bake_id": {
      "type": "string",
      "pattern": "^bk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "decomposition_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extractor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "is_reference": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "config",
        "config_hash"
      ]
    },
    "feature_registry_version": {
      "type": "string"
    },
    "sample_rate": {
      "type": "integer"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sample_rate": {
            "type": "integer"
          },
          "audio_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_s": {
            "type": "number"
          },
          "frame_series": {
            "type": "object",
            "properties": {
              "hop_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "n_frames": {
                "type": "integer",
                "minimum": 0
              },
              "file": {
                "type": "string"
              },
              "dtype": {
                "const": "float32"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "feature": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
                    },
                    "dim": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "feature",
                    "dim"
                  ]
                }
              }
            },
            "required": [
              "hop_s",
              "n_frames",
              "file",
              "columns"
            ]
          },
          "slices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "i": {
                  "type": "integer",
                  "minimum": 0
                },
                "t0": {
                  "type": "number",
                  "minimum": 0
                },
                "t1": {
                  "type": "number",
                  "minimum": 0
                },
                "features": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "number",
                      "array"
                    ],
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "features_start": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "features_end": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              },
              "required": [
                "i",
                "t0",
                "t1",
                "features"
              ]
            }
          },
          "summary": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "unit": {
                  "type": "string"
                },
                "dims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "mean": {
                        "type": "number"
                      },
                      "std": {
                        "type": "number"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "slope": {
                        "type": "number"
                      },
                      "envelope": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "mean",
                      "std",
                      "min",
                      "max",
                      "slope",
                      "envelope"
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": [
                "dims"
              ]
            }
          },
          "scalars": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "name",
          "duration_s",
          "summary",
          "slices"
        ]
      }
    },
    "suggestions": {
      "type": "object",
      "properties": {
        "tempo_bpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "tempo_strength": {
          "type": [
            "number",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "meter": {
          "type": [
            "integer",
            "null"
          ]
        },
        "genre": {
          "type": [
            "string",
            "null"
          ],
          "description": "A suggestion only (from the essentia tagger's top class) -- never a Bake's authoritative genre. See tags.essentia."
        },
        "genre_confidence": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "tags": {
      "type": "object",
      "description": "Raw output of the external taggers (analysis/external_tags.py): {\"madmom\": {...}, \"essentia\": {...}}. Informational; suggestions above is what the UI reads.",
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "schema",
    "analysis_version",
    "analysis_id",
    "bake_id",
    "decomposition_id",
    "created_at",
    "extractor",
    "feature_registry_version",
    "sample_rate",
    "sources"
  ],
  "additionalProperties": true
}
