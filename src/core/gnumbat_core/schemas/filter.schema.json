{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnumbat.local/schemas/filter.schema.json",
  "title": "Bake filter query",
  "$ref": "#/$defs/query",
  "$defs": {
    "query": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/query"
              }
            }
          },
          "required": [
            "and"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/query"
              }
            }
          },
          "required": [
            "or"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/query"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte",
                "between",
                "in",
                "contains",
                "has",
                "prefix",
                "exists"
              ]
            },
            "value": {}
          },
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
