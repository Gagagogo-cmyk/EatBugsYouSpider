{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnumbat.local/schemas/dataset_version.schema.json",
  "title": "DatasetVersion (immutable pin of Bakes + labels + analysis)",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^gnumbat\\.dataset_version/0\\.[0-9]+$"
    },
    "dataset_version_id": {
      "type": "string",
      "pattern": "^dv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^ds_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "analysis_profile": {
      "type": "object",
      "properties": {
        "extractor": {
          "type": "string"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "extractor",
        "config_hash"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "bake_id": {
            "type": "string",
            "pattern": "^bk_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "semantic_rev": {
            "type": "integer",
            "minimum": 1
          },
          "semantic_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "analysis_id": {
            "type": "string",
            "pattern": "^an_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "decomposition_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "bake_id",
          "content_hash",
          "semantic_rev",
          "semantic_hash",
          "analysis_id",
          "decomposition_id"
        ]
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "version_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "dataset_version_id",
    "dataset_id",
    "created_at",
    "analysis_profile",
    "items",
    "vocabulary",
    "version_hash"
  ],
  "additionalProperties": true
}
