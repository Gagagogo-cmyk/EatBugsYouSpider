#N canvas 100 100 620 480 12;
#X obj 40 20 inlet;
#X obj 260 20 inlet;
#X obj 420 20 loadbang;
#X obj 420 70 array size $1;
#X obj 40 90 phasor~ 0.1;
#X obj 40 150 *~ 0;
#X obj 40 210 tabread4~ $1;
#X obj 260 90 expr 1 - $f1;
#X obj 40 270 *~ 1;
#X obj 40 330 outlet~;
#X text 150 400 stem_preview~ $1: minimal buffer-scrub preview player\, NEW (never existed in the Max patch). Added purely so the per-stem/master spectrum-analyzer filterbanks and the waveform display have some live signal to look at\, since their old mono-mix feed (the pan/width summing bus) was removed -- this is NOT a real playback engine (no pitch/EQ/gain/pan/mixing\, all of that lives in the DAW now)., f 420;
#X text 150 300 Inlet 0 (optional) = scan rate in Hz\, default 0.1 (one slow pass over the whole buffer every ~10s -- deliberately gentle\, for visual exploration\, not fast playback). Inlet 1 (optional) = mute\, float 0/1 (1 = silent\, default 0 = audible). Outlet 0 = mono signal., f 260;
#X text 150 20 rate (Hz), f 100;
#X text 300 20 mute 0/1, f 100;
#X connect 0 0 4 0;
#X connect 1 0 7 0;
#X connect 2 0 3 0;
#X connect 3 0 5 1;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 8 0;
#X connect 7 0 8 1;
#X connect 8 0 9 0;
